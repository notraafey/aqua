# ==============================================================================
# AquaSentinel Environment Configuration
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development

# Operating Mode: 'demo' uses deterministic seed/mock data, 'live' connects to external APIs
APP_MODE=demo

# Backend Server Configuration
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL with PostGIS support)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aquasentinel
DATABASE_TEST_URL=postgres://postgres:postgres@localhost:5432/aquasentinel_test

# External FHIR Server Endpoint (HAPI FHIR R4)
FHIR_SERVER_URL=http://localhost:8080/fhir

# Structured Logging Level (error | warn | info | http | debug)
LOG_LEVEL=info

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security & Secret Keys (placeholder for prototype)
API_SECRET_KEY=aquasentinel-dev-secret-key-replace-in-prod

# Copernicus Data Space / Sentinel Hub OAuth Credentials (for live satellite ingestion)
# Register at https://dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_API_URL=https://sh.dataspace.copernicus.eu/api/v1

# Open-Meteo Environmental Weather API (Free public API, no key required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1

# Citizen Science Ingestion Endpoint
CITIZEN_API_URL=

# External Consumer & FHIR REST-Hook Destination (Volos Public Health Portal)
EXTERNAL_CONSUMER_URL=http://localhost:3002/webhook/fhir
CONSUMER_PORT=3002

# Outbox Delivery Worker Settings
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_RETRIES=3
OUTBOX_RETRY_BACKOFF_MS=500

# FHIR Server Authentication Mode (none | basic | bearer | oauth2)
FHIR_AUTH_MODE=none
FHIR_AUTH_TOKEN=

# Frontend Configuration
VITE_API_URL=http://localhost:3001
